#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "${REPO_ROOT}"

echo "pre-commit: running make ci..."
if ! command -v golangci-lint >/dev/null 2>&1; then
  echo "error: golangci-lint not found"
  echo "install: brew install golangci-lint"
  exit 1
fi

make ci

echo "pre-commit: ok"
